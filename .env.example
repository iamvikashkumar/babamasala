# ============================================================
# Copy this file to .env (frontend) and .env (for the seed script,
# same folder is fine) and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.
# ============================================================

# --- Used by the React app (safe to expose in the browser) ---
# Find these in Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Used ONLY by supabase/seed/seed.mjs, run locally from your terminal ---
# This key bypasses Row Level Security — never expose it in frontend code,
# never commit it, never put it in Vercel's frontend env vars.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
